{
  "name": "party-tactics",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts",
    "games": "tsx scripts/games.ts",
    "perf": "node scripts/perf.cjs",
    "lint": "oxlint --deny-warnings src scripts vite.config.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "oxlint": "1.86.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
